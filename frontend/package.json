{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prepare": "cd .. && husky"
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "eslint --fix --max-warnings=0",
      "vue-tsc --noEmit"
    ]
  },
  "dependencies": {
    "@types/markdown-it": "^14.1.2",
    "axios": "^1.15.1",
    "dompurify": "3.4.7",
    "echarts": "^6.0.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.1.1",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.3",
    "@types/dompurify": "3.0.5",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "tailwindcss": "^4.2.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.59.3",
