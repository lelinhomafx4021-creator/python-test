# Runtime env file loaded by the app: .env
# Copy this file to .env and fill in real secrets before starting the service.

# --- Basic ---
APP_ENV=dev
PROJECT_NAME=AI-Investor-Core

# --- Database ---
# Root docker-compose in this project exposes PostgreSQL on 127.0.0.1:5432
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/ai_investor

# --- LLM / AI Provider ---
# Main chat model provider (current code uses DeepSeek)
DEEPSEEK_API=your_deepseek_api_key

# Embedding / vector helper provider
DASH_API_KEY=your_dashscope_api_key

# Web search provider
SEARCHER_API=your_tavily_api_key
SEARCHER_API_URL=https://api.tavily.com

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENABLED=true
