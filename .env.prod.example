# ── 数据库 ──
MYSQL_ROOT_PASSWORD=your_mysql_password
MYSQL_URL=jdbc:mysql://mysql:3306/ai_investor?useSSL=false&serverTimezone=GMT%2B8&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password

# ── Redis ──
REDIS_HOST=redis

# ── RabbitMQ ──
RABBITMQ_HOST=rabbitmq
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=your_rabbitmq_password

# ── PostgreSQL（向量库） ──
POSTGRES_PASSWORD=your_postgres_password

# ── Python AI ──
DEEPSEEK_API=your_deepseek_api_key
DASH_API_KEY=your_dashscope_api_key
DATABASE_URL=postgresql://postgres:your_postgres_password@postgres:5432/ai_investor
SEARCHER_API=your_tavily_api_key

# ── 阿里云 OSS ──
ALIYUN_OSS_ACCESS_KEY_ID=your_oss_key
ALIYUN_OSS_ACCESS_KEY_SECRET=your_oss_secret
ALIYUN_OSS_PUBLIC_BASE_URL=https://your-bucket.oss-cn-beijing.aliyuncs.com

# ── 邮件 ──
MAIL_HOST=smtp.qq.com
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_email_token

# ── Langfuse ──
LANGFUSE_SECRET_KEY=your_langfuse_secret
LANGFUSE_PUBLIC_KEY=your_langfuse_public
NEXTAUTH_SECRET=random_secret_for_auth

# ── CORS ──
APP_CORS_ORIGINS=http://your-frontend-domain.com

# ── Sentinel ──
SENTINEL_DASHBOARD=sentinel-dashboard:8858
